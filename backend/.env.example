# Copy this file to .env and fill in your values

PORT=4000

# PostgreSQL connection string
# Local:  postgresql://postgres:password@localhost:5432/wps_expenses
# Supabase / Railway / Neon: paste the connection string from your dashboard
DATABASE_URL="postgresql://postgres:password@localhost:5432/wps_expenses"

# Allowed corporate email domain
ALLOWED_DOMAIN=wurth.ae

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# PRODUCTION: Replace mock token with a real JWT secret (min 32 chars, random)
JWT_SECRET=change-this-to-a-random-secret-in-production
