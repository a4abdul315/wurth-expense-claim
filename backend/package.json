    "zod":     "^3.24.0"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan":  "^1.9.9",
    "@types/node":    "^22.10.0",
    "tsx":            "^4.19.2",
    "typescript":     "^5.7.0"
