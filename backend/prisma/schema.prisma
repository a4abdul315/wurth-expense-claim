// Würth Professional Solutions — Expense Claim Database Schema
// Database: MySQL   ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  EMPLOYEE
  FINANCE
  FINANCE_SUPER
  ADMIN
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  department     String
  role           Role     @default(EMPLOYEE)
  // Bank details — Finance-managed only. Employees cannot view or edit.
  bankDetailsSet Boolean  @default(false)
  iban           String   @default("") @db.VarChar(50)
  swift          String   @default("") @db.VarChar(20)
  bankName       String   @default("") @db.VarChar(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claims         ExpenseClaim[]
  threads        ThreadParticipant[]
  messages       ThreadMessage[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([email])
}

model ExpenseClaim {
  id                String      @id @default(cuid())
  reference         String?     @unique @db.VarChar(30)
  employeeId        String
  assignedFinanceId String?     // the one finance person the employee chose
  status            ClaimStatus @default(DRAFT)
  totalAed          Decimal     @default(0) @db.Decimal(12, 2)
  notes             String?     @db.Text
  rejectReason      String?     @db.Text
  submittedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  employee    User               @relation(fields: [employeeId], references: [id])
  lines       ExpenseLineItem[]
  thread      ClaimThread?
  auditLogs   AuditLog[]

  @@index([employeeId])
  @@index([status])
  @@index([assignedFinanceId])
}

model ExpenseLineItem {
  id          String       @id @default(cuid())
  claimId     String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  category    String       @db.VarChar(100)
  eventName   String       @default("") @db.VarChar(200)
  description String       @db.VarChar(500)
  date        DateTime
  country     String       @default("") @db.VarChar(100)
  currency    String       @db.VarChar(10)
  amount      Decimal      @db.Decimal(12, 2)
  aedAmount   Decimal      @db.Decimal(12, 2)
  fxRate      Decimal      @db.Decimal(12, 8)
  receiptNo   String       @default("") @db.VarChar(50)
  createdAt   DateTime     @default(now())

  @@index([claimId])
}

// One thread per claim — Finance discussion
model ClaimThread {
  id        String    @id @default(cuid())
  claimId   String    @unique
  claim     ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  messages     ThreadMessage[]
  participants ThreadParticipant[]
}

model ThreadMessage {
  id         String      @id @default(cuid())
  threadId   String
  thread     ClaimThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id])
  content    String      @db.Text
  createdAt  DateTime    @default(now())

  @@index([threadId])
}

model ThreadParticipant {
  id         String      @id @default(cuid())
  threadId   String
  thread     ClaimThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  invitedBy  String?     // userId of the person who invited them; null = original assignee
  joinedAt   DateTime    @default(now())

  @@unique([threadId, userId])
  @@index([threadId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @db.VarChar(50)  // CLAIM_ASSIGNED | THREAD_MESSAGE | THREAD_INVITE | etc.
  title     String   @db.VarChar(200)
  body      String   @db.VarChar(500)
  claimId   String?
  threadId  String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id        String       @id @default(cuid())
  claimId   String?
  claim     ExpenseClaim? @relation(fields: [claimId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  action    String       @db.VarChar(100)
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([claimId])
  @@index([createdAt])
}
